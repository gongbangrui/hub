# 会话签名密钥。openssl rand -hex 32 生成；改动后所有登录失效
AUTH_SECRET=

# 仅首次启动时写入数据库；之后在后台设置页修改
ADMIN_PASSWORD=

# 计划任务清理过期文件用：POST /api/files/purge?key=CRON_KEY
CRON_KEY=

# 数据目录（数据库 + 上传文件）。生产环境用绝对路径，放在构建产物之外
DATA_DIR=./data

# 可选：访客临时文件配额（GB）。单访客 / 全站访客合计 / 站点总存储
# GUEST_VISITOR_QUOTA_GB=
# GUEST_TOTAL_QUOTA_GB=
# STORAGE_QUOTA_GB=
